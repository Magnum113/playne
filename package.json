{
  "name": "playne-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-pages.mjs && node scripts/check-seo.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "check:google": "node scripts/google-check.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "build:api": "node scripts/build-api.mjs",
    "dev:api": "tsx --env-file=.env.auth.local server/index.ts",
    "test:api": "vitest run server-tests"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/google.maps": "^3.66.6",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
